# ========================================================
# NIRMAN AI PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================

# Application Configuration
PROJECT_NAME="Nirman AI Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development" # development | staging | production

# Security & Authentication
SECRET_KEY="nirman-production-super-secret-key-change-in-prod-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days
ALGORITHM="HS256"

# Database Configuration
# Default: Zero-setup SQLite
DATABASE_URL="sqlite+aiosqlite:///./nirman.db"
# Production PostgreSQL (Uncomment for PostgreSQL deployment):
# DATABASE_URL="postgresql+asyncpg://nirman_user:nirman_password@localhost:5432/nirman_db"

# Redis Cache & Worker Queue
REDIS_URL="redis://localhost:6379/0"

# CORS Configuration (Comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# AI Provider API Keys (Optional environment overrides)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Frontend Public Variables
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_WS_URL="ws://localhost:8000/ws"
