# Environment configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nirman
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Async Database URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nirman

# Security & JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-at-least-32-characters
JWT_REFRESH_SECRET_KEY=your-jwt-refresh-secret-key-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
